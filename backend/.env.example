# Gemini (primary — required for the 6-agent pipeline)
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Session secret (any random string works for local dev)
SESSION_SECRET=change-me-to-a-random-secret

# Optional: OpenRouter as LLM fallback if Gemini key is unavailable
OPENROUTER_API_KEY=your-openrouter-api-key
